# Copy to .env and fill in. Never commit the real file.

# --- Dashboard (Aeolus) ---
AEOLUS_APP_ID=
AEOLUS_DASHBOARD_URL=
# Optional: path to a chromedriver matching your Chrome. If empty or missing,
# Selenium Manager downloads one automatically.
AEOLUS_CHROME_DRIVER_PATH=
# Normally captured at runtime after login; only set it to skip the browser step.
AEOLUS_OPEN_API_TOKEN=

# --- Login used by the browser step ---
LARK_LOGIN_EMAIL=
LARK_LOGIN_PASSWORD=
OUTLOOK_MAIL_URL=https://outlook.office.com/mail/
OUTLOOK_EMAIL=
OUTLOOK_PASSWORD=
OUTLOOK_TOTP_SECRET=

# --- Notifications (optional) ---
LARK_WEBHOOK_URL=

# --- Lark Open API apps ---
LARK_SHEET_APP_ID=
LARK_SHEET_APP_SECRET=
LARK_BASE_APP_ID=
LARK_BASE_APP_SECRET=

# --- PostgreSQL ---
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=prefer
DB_SCHEMA=Service

# --- Parquet archive (optional) ---
# Local folder for date-partitioned Parquet; relative paths resolve from the project root.
ARCHIVE_DIR=data/archive
# Fail the run if a source has fewer rows than this, or drops by more than the ratio
# versus the previous archived day.
ARCHIVE_MIN_ROWS=1
ARCHIVE_MAX_DROP_RATIO=0.5
# Set a bucket to also upload to S3 / MinIO.
ARCHIVE_S3_BUCKET=
ARCHIVE_S3_ENDPOINT=
ARCHIVE_S3_ACCESS_KEY=
ARCHIVE_S3_SECRET_KEY=

# Run Chrome without a window (needed inside Docker).
AEOLUS_HEADLESS=false

# --- Warehouse target ---
# postgres (default) or bigquery
WAREHOUSE=postgres
# BigQuery: credentials come from Application Default Credentials
# (gcloud auth application-default login) or GOOGLE_APPLICATION_CREDENTIALS.
BQ_PROJECT=
BQ_DATASET=raw
BQ_LOCATION=
# Hard cap on bytes billed per query (10 GB here); queries above it fail instead of costing money.
BQ_MAX_BYTES_BILLED=10737418240
GOOGLE_APPLICATION_CREDENTIALS=
